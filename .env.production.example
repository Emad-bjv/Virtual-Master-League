# ============================================================
# Virtual Master League - Production Environment Variables
# ============================================================
# Copy this file to .env.production and fill in the values

# Django
DJANGO_SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_50_CHARS
DEBUG=False
ALLOWED_HOSTS=37.32.36.252,server-2c470db9-69e5-4b6c-ac27-d99354bca375.ir-southwest1-a.arvancompute.ir

# CORS - frontend origin (same server, served by nginx on port 80)
CORS_ALLOWED_ORIGINS=http://37.32.36.252,http://server-2c470db9-69e5-4b6c-ac27-d99354bca375.ir-southwest1-a.arvancompute.ir

# Database (PostgreSQL inside Docker)
DB_NAME=vml_db
DB_USER=vml_user
DB_PASSWORD=CHANGE_THIS_TO_A_STRONG_DB_PASSWORD

# Redis (inside Docker)
REDIS_URL=redis://redis:6379/0

# ZarinPal (if payment needed)
ZARINPAL_MERCHANT_ID=your-zarinpal-merchant-id

# Telegram (optional)
